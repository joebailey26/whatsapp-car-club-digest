{
  "name": "whatsapp-car-club-digest",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Weekly email digest of WhatsApp car club groups, running on Cloudflare (Containers, R2, D1, Workers AI, Email Service).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.browser-tests.json && pnpm --dir browser run typecheck",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "build": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": "^24.18.0",
    "pnpm": "^10.11.1"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
